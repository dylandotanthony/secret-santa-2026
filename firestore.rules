rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Last year's matches (giver -> receiver) can't repeat
    function isRepeat(pair) {
      return (pair.giver == 'beth' && pair.receiver == 'dylan')
        || (pair.giver == 'dylan' && pair.receiver == 'alexis')
        || (pair.giver == 'alexis' && pair.receiver == 'jayd')
        || (pair.giver == 'jayd' && pair.receiver == 'cody')
        || (pair.giver == 'cody' && pair.receiver == 'patrick')
        || (pair.giver == 'patrick' && pair.receiver == 'beth');
    }

    match /wishlists/{personId} {
      allow read: if true;
      allow write: if personId in ['alexis', 'cody', 'beth', 'jayd', 'patrick', 'dylan']
        && request.resource.data.keys().hasOnly(['wishlistUrl', 'notes', 'updatedAt'])
        && request.resource.data.wishlistUrl is string
        && request.resource.data.wishlistUrl.size() < 500
        && request.resource.data.notes is string
        && request.resource.data.notes.size() < 2000;
    }
    match /draw/{docId} {
      allow read: if true;
      allow create: if docId == 'official'
        && request.resource.data.keys().hasOnly(['pairs', 'drawnAt', 'enforceCouples'])
        && request.resource.data.pairs is list
        && request.resource.data.pairs.size() == 6
        && !isRepeat(request.resource.data.pairs[0])
        && !isRepeat(request.resource.data.pairs[1])
        && !isRepeat(request.resource.data.pairs[2])
        && !isRepeat(request.resource.data.pairs[3])
        && !isRepeat(request.resource.data.pairs[4])
        && !isRepeat(request.resource.data.pairs[5]);
    }
  }
}
